{
	"schemaVersion": 1,
	"id": "${mod_id}",
	"version": "${version}",
	"name": "${mod_name}",
	"description": "${mod_description}",
	"authors": [
		"lokifisch"
	],
	"contact": {},
	"license": "MIT",
	"icon": "assets/nexomod/icon.png",
	"environment": "client",
